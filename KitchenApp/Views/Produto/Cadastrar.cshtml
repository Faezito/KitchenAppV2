@model ProdutoModel;

@{
}
<div id="categoriasTemplate" style="display: none;">
    @await Component.InvokeAsync("DropIngredienteCategorias")
</div>
<div id="medidaTemplate" style="display: none;">
    @await Component.InvokeAsync("DropUnidadesMedida")
</div>
<div id="ingredienteTemplates" style="display: none;">
    @await Component.InvokeAsync("DropIngredientes")
</div>


<div class="row">
    <div class="col-auto">
        <form class="form d-grid gap-3" method="POST" asp-action="Cadastrar">
            @Html.HiddenFor(x => x.ProdutoID)

            <div class="row gap-4">
                <input type="text" asp-for="Nome" class="col form-control" placeholder="Nome" />
                <select class="col form-control" asp-for="Categoria">
                    <option value="0" disabled>Categoria</option>
                    @await Component.InvokeAsync("DropCategorias")
                </select>
            </div>
            <div class="row gap-4">
                <input type="text" asp-for="Custo" class="col form-control money" placeholder="Custo" />
                <input type="text" asp-for="Preco" class="col form-control money" placeholder="Venda" />
            </div>

            <button id="addIngrediente" type="button" class="btn btn-primary mb-2">+</button>
            
            <div id="ingredientes">
                @if (Model.Ingredientes != null && Model.Ingredientes.Any())
                {
                    for (int i = 0; i < Model.Ingredientes.Count; i++)
                    {
                        <div class="col-12 d-flex mb-2 align-items-center">
                            @Html.HiddenFor(m => m.Ingredientes[i].IngredienteID)
                            @Html.TextBoxFor(m => m.Ingredientes[i].IngredienteDescr,
                            new { @class = "form-control me-2", @readonly = "readonly" })
                            @Html.TextBoxFor(m => m.Ingredientes[i].Quantidade,
                                        new { @class = "form-control me-2" })

                    <button type="button" class="btn btn-danger btn-sm removeIngrediente">X</button>

                </div>
                    }
                }
            </div>

            <div class="row" id="ingredientesContainer">
            </div>

            <button type="submit" class="btn btn-success">Salvar</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-mask/jquery.mask.js"></script>
    <script>
        $(document).ready(function() {
            let ingredientesIndex = @Model.Ingredientes?.Count() ?? 0;

            $("#addIngrediente").click(function(e) {
                e.preventDefault();
                var categoriasTemplate = $("#categoriasTemplate").html();
                var medidaTemplate = $("#medidaTemplate").html();
                var ingredienteTemplates = $("#ingredienteTemplates").html();
                var formHtml = `
                    <div class="col-12 d-flex mb-2 align-items-center">
                        <select class="form-control me-2" name="Ingredientes[${ingredientesIndex}].IngredienteID">
                            <option value="0" disabled>Ingrediente</option>
                            ${ingredienteTemplates}
                        </select>
                        <input type="text" name="Ingredientes[${ingredientesIndex}].Quantidade" class="form-control me-2" placeholder="Quantidade" />

                        <button type="button" class="btn btn-danger btn-sm removeIngrediente">X</button>
                    </div>
                `;
                $("#ingredientesContainer").append(formHtml);
                ingredientesIndex++;
            });

            // TODO: CONSERTAR REMOÇÃO DOS ITENS

            // remover ingrediente
            $("#ingredientesContainer").on("click", ".removeIngrediente", function() {
                $(this).parent().remove();
            });
            $("#ingredientes").on("click", ".removeIngrediente", function() {
                $(this).parent().remove();
            });
            $('.date').mask('00/00/0000');
            $('.money').mask('000.000.000.000.000,00', { reverse: true });
        });

    </script>
}