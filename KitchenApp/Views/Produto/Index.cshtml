@model List<ProdutoModel>


@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@foreach (var i in Model)
{
    <div class="card" style="width: 18rem;">
        <img src="..." class="card-img-top" alt="...">
        <div class="card-body">
            <h5 class="card-title">@i.Nome</h5>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">@i.Preco</li>
                <li class="list-group-item">@i.Custo</li>
                <li class="list-group-item">@i.Categoria</li>
            </ul>
            <div class="card-body">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                    <label class="form-check-label" for="switchCheckDefault">Ativo</label>
                </div>
                <a href="#" class="card-link">Editar</a>
                <a href="#" class="card-link">Deletar</a>
            </div>
        </div>
    </div>
}