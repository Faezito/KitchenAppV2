@model List<ProdutoModel>


<div class="row">
    <div class="col-4">
        <h1>
            Produtos
        </h1>
    </div>
    <div class="col-2 offset-6">
        <a class="btn btn-primary" asp-action="Cadastrar">
            Cadastrar
        </a>
    </div>

</div>



<div class="row d-flex gap-4 justify-content-center">
    @foreach (var i in Model)
    {
        <div class="card" style="width: 18rem;">
            <img src="..." class="card-img-top" alt="...">
            <div class="card-body text-center">
                <h5 class="card-title">@i.Nome</h5>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        R$ @string.Format("{0:n2}", i.Preco)
                    </li>
                    <li class="list-group-item">R$ @string.Format("{0:n2}", i.Custo)</li>
                    <li class="list-group-item">@i.Categoria</li>
                </ul>
                <div class="card-body">
                    <div class="row">
                        <div class="form-check form-switch mb-3 w-auto mx-auto">
                            <input class="form-check-input" value="@i.Ativo" type="checkbox" role="switch" id="switchCheckDefault"
                                   @(i.Ativo ? "checked" : "")>
                            <label class="form-check-label" for="switchCheckDefault">Ativo</label>
                        </div>
                    </div>
                    <div class="w-100 d-flex justify-content-center">
                        <a asp-action="Cadastrar" asp-route-id="@i.ProdutoID" class="card-link btn btn-secondary">Editar</a>
                        <form asp-action="Deletar" asp-route-id="@i.ProdutoID" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="card-link btn btn-danger">Deletar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>